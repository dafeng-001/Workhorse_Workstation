{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "牛马工作台",
    "version": "0.0.18",
    "identifier":  "com.mimo.niu-ma-workbench",
    "build":  {
                  "frontendDist":  "../src",
                  "beforeDevCommand":  "",
                  "beforeBuildCommand":  ""
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "牛马工作台",
                                    "width":  1120,
                                    "height":  760,
                                    "minWidth":  880,
                                    "minHeight":  560,
                                    "center":  true,
                                    "resizable":  true,
                                    "visible":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/icon.png",
                                "icons/icon.ico"
                            ],
                   "resources":  [

                                 ],
                   "windows":  {
                                   "webviewInstallMode":  {
                                                              "type":  "skip"
                                                          },
                                   "nsis":  {
                                                "installMode":  "currentUser"
                                            }
                               }
               },
    "plugins":  {

                }
}
